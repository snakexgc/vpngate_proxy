<Window x:Class="VPNGate.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vpngate_proxy" Width="1370" Height="890" MinWidth="1160" MinHeight="770" Background="#F3F6FB" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="86" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E2E8F1" BorderThickness="0,0,0,1" Padding="28,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#2164EA" CornerRadius="10" Width="43" Height="43" Margin="0,0,14,0"><TextBlock Text="V" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel><TextBlock Text="vpngate_proxy" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="OPENVPN  /  上游代理链路  /  WINDOWS TUN" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="UptimeText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0" />
          <Border x:Name="StatusPill" Background="#EFF3F8" CornerRadius="16" Padding="14,7"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#8A98AB" Margin="0,0,8,0" /><TextBlock x:Name="StatusText" Text="未连接" /></StackPanel></Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="22,20,22,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="292" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="20,20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="连接设置" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="按模式直连或经 OpenVPN，上游代理承载节点传输。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,2" />
            <StackPanel x:Name="SettingsPanel">
              <TextBlock Text="VPN 上游代理地址" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="UpstreamBox" Text="http://127.0.0.1:10808" ToolTip="http://、https://、socks5://、socks4://、socks4a://" />
              <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="用户名（可选）" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UsernameBox" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="密码（可选）" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="PasswordBox" /></StackPanel>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="本地监听地址" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ListenBox" Text="127.0.0.1" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="端口" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PortBox" Text="10800" /></StackPanel>
              </Grid>
              <TextBlock Text="同一端口提供 HTTP 与 SOCKS5 代理" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" />
              <Expander Header="测速设置" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="HTTPS 测试地址" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ProbeUrlBox" FontSize="11" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="并发数" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ConcurrencyBox" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="连接超时（秒）" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TimeoutBox" /></StackPanel>
                  </Grid>
                  <TextBlock Text="实际建立 OpenVPN 连接后测量 HTTPS 请求延时，取 3 次采样的中位数。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
              </Expander>
            </StackPanel>
            <Border Background="#F3F7FF" CornerRadius="7" Padding="12" Margin="0,16,0,0"><StackPanel>
              <TextBlock Text="流量模式" FontWeight="SemiBold" />
              <UniformGrid x:Name="RoutingModePanel" Columns="3" Margin="0,10,0,8">
                <RadioButton x:Name="GlobalModeButton" GroupName="RoutingMode" Content="全局" Tag="global" Checked="RoutingMode_Checked" />
                <RadioButton x:Name="RuleModeButton" GroupName="RoutingMode" Content="规则" Tag="rule" Checked="RoutingMode_Checked" />
                <RadioButton x:Name="DirectModeButton" GroupName="RoutingMode" Content="直连" Tag="direct" Checked="RoutingMode_Checked" />
              </UniformGrid>
              <TextBlock x:Name="RoutingStateText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" />
              <Expander x:Name="RulesExpander" Header="分流规则" Margin="0,10,0,0"><StackPanel>
                <TextBlock Text="SagerNet 中国域名 + 中国 IP；局域网始终直连。" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,8" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="44" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                  <CheckBox x:Name="AutoRulesBox" Content="自动更新" VerticalAlignment="Center" Click="RulesPreferences_Changed" />
                  <TextBox x:Name="RuleHoursBox" Grid.Column="1" Text="24" Padding="5,5" LostFocus="RulesPreferences_Changed" />
                  <TextBlock Text="小时" Grid.Column="2" VerticalAlignment="Center" FontSize="10" Margin="3,0,0,0" />
                </Grid>
                <TextBlock x:Name="RulesStatusText" Text="内置规则已就绪" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <Button x:Name="UpdateRulesButton" Content="立即更新规则" Click="UpdateRules_Click" Margin="0,8,0,0" />
              </StackPanel></Expander>
            </StackPanel></Border>
            <Button x:Name="SaveButton" Content="保存设置" Margin="0,18,0,0" Click="Save_Click" />
            <Border Height="1" Background="#E2E8F1" Margin="0,20,0,16" />
            <TextBlock Text="流量路径" FontSize="12" FontWeight="SemiBold" />
            <TextBlock x:Name="TrafficPathText" Text="应用 / TUN → 国内直连&#x0a;               → 其他经 OpenVPN → 上游代理" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="20" Margin="0,7,0,0" />
            <TextBlock x:Name="PrivilegeText" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,15,0,0" />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#F3F7FF" CornerRadius="7" Padding="12" Margin="0,16,0,0"><StackPanel>
          <TextBlock Text="TUN 模式" FontWeight="SemiBold" />
          <Button x:Name="TunButton" Content="开启 TUN" Click="Tun_Click" Margin="0,10,0,0" Style="{StaticResource PrimaryButton}" />
          <TextBlock x:Name="TunStateText" Text="TUN 已关闭。可随时独立开启或关闭。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="99" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="126" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前节点" Foreground="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="ConnectedNodeText" Text="等待连接" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="ConnectedCountryText" Text="从下方列表选择一个节点" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="节点网络延时" Foreground="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="LatencyText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="ExitIpText" Text="节点出口 IP：—" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" /></StackPanel></Border>
          <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="本地代理入口" Foreground="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="LocalProxyText" Text="127.0.0.1:10800" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock x:Name="ModeText" Text="HTTP + SOCKS5" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="18,15,18,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><TextBlock Text="VPNGate 节点" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="NodeCountText" Text="0 个节点" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" /></StackPanel>
              <Button x:Name="FetchButton" Grid.Column="1" Content="获取 / 刷新节点" Click="Fetch_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="18,0,18,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="142" /><ColumnDefinition Width="12" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="搜索国家、IP 或节点名称" VerticalContentAlignment="Center" />
              <ComboBox x:Name="CountryBox" Grid.Column="2" SelectionChanged="Country_Changed" DisplayMemberPath="Label" />
              <ComboBox x:Name="SortBox" Grid.Column="4" SelectionChanged="Sort_Changed" SelectedIndex="0"><ComboBoxItem Content="默认：评分" /><ComboBoxItem Content="网络延时 ↑" /><ComboBoxItem Content="国家 A → Z" /><ComboBoxItem Content="网络延时 ↓" /></ComboBox>
            </Grid>
            <DataGrid x:Name="NodeGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" BorderThickness="0" RowHeaderWidth="0" CanUserAddRows="False" CanUserResizeRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" Sorting="NodeGrid_Sorting" SelectionChanged="NodeGrid_SelectionChanged" MouseDoubleClick="NodeGrid_DoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="国家 / 地区" Binding="{Binding CountryLabel}" SortMemberPath="CountryShort" Width="132" />
                <DataGridTextColumn Header="节点 / IP" Binding="{Binding Ip}" SortMemberPath="Ip" Width="180" />
                <DataGridTextColumn Header="节点类型" Binding="{Binding NodeType}" SortMemberPath="NodeType" Width="*" MinWidth="110" MaxWidth="180">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding NodeTypeDetail}" /></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="网络延时" Binding="{Binding LatencyText}" SortMemberPath="LatencyMs" Width="94" />
                <DataGridTextColumn Header="状态" Binding="{Binding TestStatus}" SortMemberPath="TestStatus" Width="76" />
                <DataGridTextColumn Header="公布带宽" Binding="{Binding SpeedText}" SortMemberPath="Speed" Width="105" />
                <DataGridTextColumn Header="公布 Ping" Binding="{Binding AdvertisedPingText}" SortMemberPath="AdvertisedPing" Width="95" />
                <DataGridTextColumn Header="会话" Binding="{Binding Sessions}" SortMemberPath="Sessions" Width="61" />
                <DataGridTextColumn Header="协议" Binding="{Binding Transport}" SortMemberPath="Transport" Width="57" />
              </DataGrid.Columns>
              <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Error}" /></Style></DataGrid.RowStyle>
            </DataGrid>
            <Border Grid.Row="3" BorderBrush="#E2E8F1" BorderThickness="0,1,0,0" Padding="18,12"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="ConnectButton" Content="连接选中节点" Style="{StaticResource PrimaryButton}" Click="Connect_Click" />
                <Button x:Name="DisconnectButton" Grid.Column="1" Content="断开" Margin="8,0,0,0" Click="Disconnect_Click" IsEnabled="False" />
                <Button x:Name="TestSelectedButton" Grid.Column="3" Content="测选中" Click="TestSelected_Click" />
                <Button x:Name="TestAllButton" Grid.Column="4" Content="测全部" Margin="8,0,0,0" Click="TestAll_Click" />
                <Button x:Name="CancelTestsButton" Grid.Column="5" Content="取消" Margin="8,0,0,0" Click="CancelTests_Click" IsEnabled="False" />
              </Grid>
              <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgressText" Text="获取节点后可连接。Ctrl / Shift 可多选测速；双击节点可切换。" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ProgressBar x:Name="TestProgress" Grid.Column="1" Height="4" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Accent}" Background="#E7EEF9" Margin="10,0,0,0" BorderThickness="0" />
              </Grid>
            </StackPanel></Border>
          </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="15,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="运行日志" FontSize="11" FontWeight="SemiBold" /><Button Grid.Column="1" Content="导出测速 CSV" FontSize="10" Padding="8,2" Click="Export_Click" /><Button Grid.Column="2" Content="日志目录" FontSize="10" Padding="8,2" Margin="8,0,0,0" Click="OpenLogs_Click" /></Grid><TextBox x:Name="LogBox" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True" BorderThickness="0" Padding="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10" Foreground="#738197" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" /></Grid></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F1" BorderThickness="0,1,0,0" Padding="24,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="FooterText" Text="就绪 · 节点列表来自 VPNGate" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Grid.Column="1" Text="本地模式无需管理员  ·  sing-box 1.14.2" Foreground="{StaticResource Muted}" FontSize="10" /></Grid></Border>
  </Grid>
</Window>
